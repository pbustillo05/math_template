{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Math: build PDF",
      "type": "process",
      "command": "make",
      "args": [
        "pdf"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Math: build active TeX",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build_latex.py",
        "--source",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Math: check",
      "type": "process",
      "command": "make",
      "args": [
        "check"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Math: dependency graph",
      "type": "process",
      "command": "make",
      "args": [
        "graph"
      ],
      "problemMatcher": []
    }
  ]
}
